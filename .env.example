# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Authentication (Next Auth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret
# AUTH_SECRET is also used by newer versions of Auth.js
AUTH_SECRET=your-auth-secret

# Google OAuth
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Instagram API / Facebook
FACEBOOK_APP_ID=your-app-id
FACEBOOK_APP_SECRET=your-app-secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/callback/facebook
NEXT_PUBLIC_FACEBOOK_APP_ID=your-app-id

# Token Encryption (AES-256-GCM, 32 bytes = 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your-64-char-hex-key

# Webhooks / Cron
CRON_SECRET=your-cron-secret
WEBHOOK_SECRET=your-webhook-secret

# Local Cron Runner (development only)
ENABLE_LOCAL_CRON=false
# Per-job overrides (uncomment to use):
# CRON_ENABLE_IDENTITY_AUDIT=true
# CRON_DISABLE_PROCESS=true

# Sentry
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# Railway Video Processor (fallback for Vercel where FFmpeg is unavailable)
RAILWAY_API_URL=https://your-service.railway.app
RAILWAY_API_SECRET=your-railway-api-secret

# AI Analysis (Optional)
OPENAI_API_KEY=your-openai-api-key

# TikTok API (register at https://developers.tiktok.com)
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# Pixabay Audio API (free key from https://pixabay.com/api/docs/)
PIXABAY_API_KEY=your-pixabay-api-key

# Local Storage (for story archive, audio, composed videos)
DATA_DIR=./data

# TikTok Pipeline
TIKTOK_PIPELINE_ENABLED=false
TIKTOK_MIN_ENGAGEMENT_SCORE=100
TIKTOK_STORIES_PER_VIDEO=7

# Redis (BullMQ job queues — run via docker-compose)
REDIS_URL=redis://localhost:6379

# Google Drive Storage (run scripts/setup-drive.ts once to obtain refresh token)
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are shared with Google OAuth above
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-drive-root-folder-id

# ComfyUI (AI image generation on second PC — AMD RX 7700 XT)
COMFYUI_URL=http://192.168.1.x:8188

# AI / Generation APIs
FAL_API_KEY=your-fal-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Notifications (Resend for email alerts — publish failures, token expiry)
RESEND_API_KEY=your-resend-api-key
